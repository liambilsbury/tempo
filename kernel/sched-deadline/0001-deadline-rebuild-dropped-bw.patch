+/* Root domain holding p's bandwidth: task_cpu(p)'s, or an allowed active CPU's */
+static struct root_domain *dl_task_rd(struct task_struct *p)
+{
+	int cpu = task_cpu(p);
+
+	if (!cpu_active(cpu)) {
+		int active = cpumask_first_and(cpu_active_mask, p->cpus_ptr);
+
+		if (active < nr_cpu_ids)
+			cpu = active;
+	}
+	return cpu_rq(cpu)->rd;
+}
+
+/* Skip if a rebuild already dropped p's bandwidth. */
+static void dl_task_sub_bw(struct task_struct *p)
+{
+	struct root_domain *rd = dl_task_rd(p);
+	struct dl_bw *dl_b = &rd->dl_bw;
+
+	raw_spin_lock(&dl_b->lock);
+	if (READ_ONCE(p->dl.dl_bw_gen) == READ_ONCE(dl_bw_gen))
+		__dl_sub(dl_b, p->dl.dl_bw, cpumask_weight(rd->span));
+	raw_spin_unlock(&dl_b->lock);
+}
